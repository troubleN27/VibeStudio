# Database
# Локальная разработка (файловый SQLite):
DATABASE_URL="file:./dev.db"
# Production (Vercel) — облачная база Turso. Если задан, используется libSQL-адаптер.
# TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
# TURSO_AUTH_TOKEN=""

# NextAuth
NEXTAUTH_SECRET="changeme-please-generate-a-strong-secret"
NEXTAUTH_URL="http://localhost:3000"

# Telegram Bot
TELEGRAM_BOT_TOKEN="123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"
TELEGRAM_ADMIN_CHAT_ID="123456789"

# Публичный username бота (без @, без https://t.me/) — для ссылок на сайте
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="vibe_studio_bot"

# Secret token для защиты webhook (используется в production)
TELEGRAM_WEBHOOK_SECRET=""

# Environment
NODE_ENV="development"