generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Hall {
  id           String         @id @default(cuid())
  name         String
  description  String?
  photoUrl     String?
  isActive     Boolean        @default(true)
  services     Service[]
  bookings     Booking[]
  workingHours WorkingHours[]
  blockedSlots BlockedSlot[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Service {
  id          String    @id @default(cuid())
  name        String
  description String?
  price       Decimal
  durationMin Int
  hallId      String
  hall        Hall      @relation(fields: [hallId], references: [id])
  bookings    Booking[]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([hallId])
}

model WorkingHours {
  id        String @id @default(cuid())
  hallId    String
  hall      Hall   @relation(fields: [hallId], references: [id])
  dayOfWeek Int    // 0 = воскресенье ... 6 = суббота
  startTime String // "10:00"
  endTime   String // "22:00"

  @@unique([hallId, dayOfWeek])
}

model BlockedSlot {
  id        String   @id @default(cuid())
  hallId    String
  hall      Hall     @relation(fields: [hallId], references: [id])
  date      DateTime // дата без времени (00:00 UTC)
  startTime String?  // null = блокирует весь день
  endTime   String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([hallId, date])
}

model Client {
  id         String    @id @default(cuid())
  name       String
  phone      String    @unique
  telegramId String?   @unique
  bookings   Booking[]
  createdAt  DateTime  @default(now())
}

model Booking {
  id         String   @id @default(cuid())
  hallId     String
  hall       Hall     @relation(fields: [hallId], references: [id])
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  date       DateTime // дата бронирования (00:00)
  startTime  String // "14:00"
  endTime    String // "15:30" (вычисляется из startTime + durationMin)
  totalPrice Decimal
  status     String   @default("CONFIRMED") // PENDING | CONFIRMED | COMPLETED | CANCELLED_BY_CLIENT | CANCELLED_BY_ADMIN | NO_SHOW
  source     String // WEBSITE | TELEGRAM
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([hallId, date])
  @@index([status])
}

model AdminUser {
  id           String @id @default(cuid())
  login        String @unique
  passwordHash String
}